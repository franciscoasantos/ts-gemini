# --- TeamSpeak ---
TS_HOST=meu.servidor.com
TS_PORT=9987
TS_NICK=Gemini
# Nome ou ID do canal onde o bot fica (vazio = canal padrão)
TS_CHANNEL=
TS_CHANNEL_PASSWORD=
TS_SERVER_PASSWORD=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Wake word (reconhecimento em português via Whisper + VAD) ---
# Pasta do modelo (baixada no build do Docker)
KWS_DIR=/app/model
# Tamanho do modelo Whisper: tiny | base | small (precisa bater com o baixado no Dockerfile)
WHISPER_PREFIX=base
# Palavras que ativam o bot (regex; a transcrição precisa conter uma delas)
WAKE_WORDS=gemini|geminai|jeminai|gueminai|gemin|jemin|jimin|gize|gêmeos|ok google|google
# Threads do reconhecedor
ASR_THREADS=2

# --- Comportamento ---
# Segundos de silêncio até encerrar a conversa (libera pra outra pessoa)
CONVO_IDLE_MS=5000
# Apelidos a ignorar na detecção (vazio = usa MUSIC_BOT_NAME). Separe por vírgula.
IGNORE_SPEAKERS=
# BEEP=0 desliga os avisos sonoros
# DEBUG_VOICE=1 loga o que o bot ouve/transcreve

# Identidade do bot (persistir em volume no Docker) e avatar
IDENTITY_FILE=/app/data/identity.json
AVATAR_FILE=avatar.png

# --- Integração com o TS6 Manager (tocar música por voz) ---
# Deixe USER/PASS vazios para desativar os comandos de música.
MANAGER_URL=http://backend:3001/api
MANAGER_USER=
MANAGER_PASS=
MUSIC_BOT_NAME=DJ Morri
