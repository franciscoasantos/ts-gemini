# TeamSpeak
TS_HOST=meu.servidor.com
TS_PORT=9987
TS_NICK=Gemini
# Nome ou ID do canal onde o bot fica (vazio = canal padrão)
TS_CHANNEL=
TS_CHANNEL_PASSWORD=
TS_SERVER_PASSWORD=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Pasta do modelo de keyword spotting (baixada no Docker)
KWS_DIR=/app/model

# Onde salvar a identidade (persistir em volume no Docker)
IDENTITY_FILE=/app/data/identity.json
# Arquivo com as palavras-chave (pedacos BPE do modelo)
KEYWORDS_FILE=keywords.txt
# DEBUG_KWS=1 ativa o log interno do spotter
# Sensibilidade da wake word (menor = mais sensível; padrão interno 0.25)
KWS_THRESHOLD=0.12
